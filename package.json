{
  "name": "driftwood",
  "private": true,
  "version": "0.1.0",
  "description": "Driftwood - um sucessor espiritual contemplativo: um náufrago vive sua própria vida numa ilha, sozinho, para sempre.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "npm run build && electron electron/main.cjs",
    "desktop:dev": "electron electron/main.cjs --dev",
    "pack:scr": "npm run build && node scripts/pack-scr.cjs"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {}
}
