{
  "name": "driftwood",
  "private": true,
  "version": "0.1.0",
  "description": "Driftwood - um sucessor espiritual contemplativo: um nautrago vive sua propria vida numa ilha, sozinho, para sempre.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && electron electron/main.cjs",
    "desktop:dev": "electron electron/main.cjs --dev",
    "pack:scr": "npm run build && node scripts/pack-scr.cjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@33.4.11": true
  }
}
